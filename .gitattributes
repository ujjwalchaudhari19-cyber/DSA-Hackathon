# Normalize line endings to LF everywhere (prevents Windows CRLF issues)
* text=auto eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.db binary
*.db-shm binary
*.db-wal binary
*.pyc binary
