# ============================================================
# GramUdyam AI — Root environment template
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Both api/ and web/ have their own .env.example for
# service-specific variables. This root file is used by
# docker-compose to provide shared values to all services.
# ============================================================

# ── LLM Provider (set at least one) ─────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ── Firebase Auth ────────────────────────────────────────────
FIREBASE_PROJECT_ID=gramudyog-d0862
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── App ──────────────────────────────────────────────────────
ENV=dev
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
